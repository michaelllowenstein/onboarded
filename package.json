{
  "name": "@onboarded/source",
  "version": "0.0.0",
  "license": "MIT",
  "description": "",
  "scripts": {
    "generate":          "python3 packages/core/scripts/generate_adapters.py --all",
    "generate:ts":       "python3 packages/core/scripts/generate_adapters.py --all --ts-only",
    "validate":          "python3 packages/core/scripts/validate_domain.py --all",

    "portal:start":      "nx serve @onboarded/portal",
    "portal:start:prod": "nx serve @onboarded/portal --configuration=production",
    "portal:start:generic": "nx serve @onboarded/portal --configuration=generic",
    "portal:build":      "nx build @onboarded/portal",
    "portal:build:prod": "nx build @onboarded/portal --configuration=production",
    "portal:build:msi":  "nx build @onboarded/portal --configuration=msi",
    "portal:build:generic": "nx build @onboarded/portal --configuration=generic",
    "portal:test":       "nx test @onboarded/portal",
    "portal:lint":       "nx lint @onboarded/portal",
    "portal:typecheck":  "nx typecheck @onboarded/portal",

    "typecheck":         "nx run-many -t typecheck",
    "build":             "nx run-many -t build",
    "test":              "nx run-many -t test",
    "test:cli":          "bats packages/cli/tests/bats/nav/test_nav_msi.bats packages/cli/tests/bats/nav/test_nav_generic.bats packages/cli/tests/bats/scan/test_scan_msi.bats",
    "test:api":          "cd packages/api && pytest --tb=short -q",
    "lint":              "nx run-many -t lint",
    "format:check":      "nx format:check",
    "format:write":      "nx format:write",
    "affected:build":    "nx affected -t build",
    "affected:test":     "nx affected -t test",
    "affected:lint":     "nx affected -t lint",
    "affected:all":      "nx affected -t build test lint typecheck",

    "graph":             "nx graph",
    "report":            "nx report"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.31",
    "@angular/cli": "^20.3.31",
    "@angular/compiler-cli": "^20.3.0",
    "@nx/angular":         "22.7.2",
    "@nx/js":              "22.7.2",
    "@nx/node":            "22.7.2",
    "@swc-node/register":  "~1.11.1",
    "@swc/core":           "~1.15.5",
    "@swc/helpers":        "~0.5.18",
    "@types/jasmine": "~5.1.0",
    "@types/react":        "^19.2.17",
    "@types/react-dom":    "^19.2.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nx":                  "22.7.2",
    "prettier":            "~3.6.2",
    "tslib":               "^2.3.0",
    "typescript":          "~5.9.2"
  },
  "overrides": {
    "less": "4.6.7"
  }
}